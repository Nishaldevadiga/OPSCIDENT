# Copy this file to deploy/.env.deploy and fill in values (deploy/.env.deploy is gitignored).
#
#   cp deploy/env.deploy.example deploy/.env.deploy
#
# Then run:  ./deploy/gcp-cloud-run.sh

GCP_PROJECT_ID=your-gcp-project-id
DJANGO_SECRET_KEY='generate-with-python-see-below'

# Optional
# GCP_REGION=us-central1
# ARTIFACT_REPO=opscident
# BACKEND_SERVICE=opscident-backend
# FRONTEND_SERVICE=opscident-frontend
# GROQ_API_KEY=

# Optional Postgres (otherwise SQLite — not durable on Cloud Run)
# DB_HOST=
# DB_NAME=insurance_db
# DB_USER=
# DB_PASSWORD=
# DB_PORT=5432

# Generate DJANGO_SECRET_KEY (from repo root, with backend venv):
#   cd backend && source venv/bin/activate && python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
